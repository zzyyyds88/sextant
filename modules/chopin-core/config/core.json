{
  "schema": 1,
  "listen": "0.0.0.0:8443",
  "data_dir": "/data/adb/chopin-core",
  "app": {
    "package": "com.chopin.pilot",
    "a11y": "com.chopin.pilot/.hud.RemoteA11yService",
    "a11y_compat": "com.chopin.pilot/com.google.android.accessibility.selecttospeak.SelectToSpeakService",
    "ime_service": "com.chopin.pilot/.ime.RemoteImeService",
    "ime_provider": "com.chopin.pilot.ime",
    "hud_package": "com.chopin.pilot"
  },
  "keepalive": {
    "interval_sec": 15,
    "a11y": {
      "enabled": true,
      "settle_max_sec": 6,
      "skip_when_foreground_settings": true
    },
    "bg": {
      "enabled": true,
      "autostart": "allow",
      "bgcontrol": "noRestrict",
      "doze": true
    },
    "perms": [
      "idle",
      "runtime"
    ]
  },
  "unlock": {
    "credential_file": "config/unlock-secret",
    "sim_pin_file": "config/sim-pin",
    "attempts": 1,
    "cooldown_sec": 30,
    "auto_on_boot": true
  },
  "session": {
    "idle_sec": 900,
    "reap_sec": 60,
    "stale_sec": 180,
    "zombie_sec": 300,
    "linger_sec": 90,
    "heartbeat_sec": 60,
    "guard_stale_sec": 600,
    "roster_ban_sec": 900,
    "max_write_sessions": 2
  },
  "helper": {
    "socket": "@chopin-core-helper",
    "dex": "lib/helper.jar"
  },
  "scrcpy": {
    "jar": "lib/scrcpy-server.jar",
    "max_size": 1280,
    "bit_rate": 4000000,
    "max_fps": 30,
    "stream_max_viewers": 3
  },
  "audit": {
    "max_bytes": 1048576,
    "keep_days": 30
  },
  "limits": {
    "max_body_bytes": 1048576,
    "request_timeout_sec": 1800
  },
  "hud": {
    "heartbeat_sec": 15,
    "capture_settle_ms": 120
  },
  "human": {
    "enabled": true,
    "gap_min_ms": 700,
    "gap_max_ms": 1600,
    "tap_inset": 6,
    "jitter_px": 6,
    "wait_min_pct": 80,
    "wait_max_pct": 135
  },
  "challenge": {
    "enabled": true,
    "slider_attempts": 2,
    "cooldown_sec": 600,
    "risk_days": 7
  }
}
