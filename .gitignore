# ---- Credentials / secrets ----
# D26: the unlock pattern lives at modules/sextant-core/config/unlock-secret
# as a local build input (0600). It is matched by *secret* below and must never
# be force-added; build-module.sh fails if it is missing.
*.key
*.pem
*.p12
*.pfx
*keybox*
*credentials*
*secret*
.env
.env.*
.adbkey
adbkey
adbkey.pub
**/.android/
**/adbkey
**/adbkey.pub

# ---- Local tool state ----
__pycache__/
*.pyc
.venv/
venv/
node_modules/
.DS_Store
*.log
*.tmp
*.swp
.cache/
